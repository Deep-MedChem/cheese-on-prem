# ── Self-hosted Supabase (on-prem auth + per-user spaces) ─────────────────────
# Rendered to ~/.config/cheese/supabase.env by `cheese setup-supabase`.
# Secrets marked __GENERATED__ are filled in by that script — do NOT commit a
# filled-in copy. To rotate a secret, blank it back to __GENERATED__ and re-run
# `cheese setup-supabase` (note: rotating JWT_SECRET invalidates all sessions
# and requires regenerating ANON_KEY / SERVICE_ROLE_KEY, which the script does).

# Public origin the *browser* uses to reach Supabase (Studio + auth + REST go
# through the gateway). Must be reachable from users' machines. setup-supabase
# defaults this per the perimeter setting in cheese-env-file.conf:
#   NGINX=true  → https://<IP>/supabase   (through the nginx SSO perimeter; the
#                 gateway's own host port stays loopback-bound, never exposed)
#   otherwise   → http://<IP>:<SUPABASE_GATEWAY_PORT>   (direct/on-box testing)
SUPABASE_PUBLIC_URL=__GENERATED__

# Who may register. Comma-separated email domains (no leading @). Anyone signing
# up with an address outside this list is rejected by a DB trigger (see
# config/supabase/sql/02-onprem-overlay.sql.template). Example: customer.com,partner.org
CHEESE_AUTH_ALLOWED_DOMAINS=example.com

# ── Secrets (generated) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=__GENERATED__
# HS256 signing secret shared by GoTrue (issues) and PostgREST (validates). >=32 chars.
JWT_SECRET=__GENERATED__
# JWTs signed from JWT_SECRET. anon = the public/browser key; service_role bypasses RLS.
ANON_KEY=__GENERATED__
SERVICE_ROLE_KEY=__GENERATED__
# Studio dashboard basic-auth (the gateway protects Studio with these).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=__GENERATED__

# ── Image pins (override to bump; defaults are the slim self-host set) ────────
SUPABASE_DB_IMAGE=supabase/postgres:15.8.1.060
SUPABASE_AUTH_IMAGE=supabase/gotrue:v2.177.0
SUPABASE_REST_IMAGE=postgrest/postgrest:v12.2.12
SUPABASE_META_IMAGE=supabase/postgres-meta:v0.89.3
SUPABASE_STUDIO_IMAGE=supabase/studio:2025.06.30-sha-6f5982d
SUPABASE_GATEWAY_IMAGE=nginx:alpine

# ── Ports / internals (rarely changed) ────────────────────────────────────────
SUPABASE_GATEWAY_PORT=8000
JWT_EXPIRY=3600
# Self-signup on (domain-restricted by the trigger above). Email confirmation is
# OFF because on-prem clusters usually have no SMTP — accounts are usable instantly.
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=true
