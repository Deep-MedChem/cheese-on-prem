#!/bin/bash
# One-shot: pull + run a slim self-hosted Supabase, load the CHEESE schema
# (accounts + per-user spaces via RLS), restrict signup to approved email
# domains, and wire the main stack to use it (ENABLE_AUTH=true). Idempotent:
# re-running keeps existing secrets and just re-applies config/schema.
#
# Usage: cheese setup-supabase

set -e
source "$(dirname "$(readlink -f "$0")")/_supabase-common"
source "$(dirname "$(readlink -f "$0")")/_editor"

CONF="${HOME}/.config/cheese/cheese-env-file.conf"
TEMPLATE="${REPO_FOLDER}/config/supabase.env.template"
SQL_SRC="${REPO_FOLDER}/config/supabase/sql"

mkdir -p "$SUPABASE_CONFIG_DIR"

# ── 1. supabase.env: create from template on first run, then fill secrets ─────
if [ ! -f "$SUPABASE_ENV_FILE" ]; then
  cp "$TEMPLATE" "$SUPABASE_ENV_FILE"
  echo "Created $SUPABASE_ENV_FILE from template."

  # Default the browser-facing URL. With the nginx SSO perimeter (NGINX=true),
  # browsers reach Supabase through nginx at https://<host>/supabase — the
  # gateway's own host port is loopback-bound and never exposed. Without the
  # perimeter, fall back to the direct gateway origin (on-box/localhost testing).
  ip="$(grep -E '^IP=' "$CONF" 2>/dev/null | head -1 | cut -d= -f2-)"; ip="${ip:-localhost}"
  nginx_on="$(grep -E '^NGINX=' "$CONF" 2>/dev/null | head -1 | cut -d= -f2-)"
  gwport="$(grep -E '^SUPABASE_GATEWAY_PORT=' "$SUPABASE_ENV_FILE" | head -1 | cut -d= -f2-)"; gwport="${gwport:-8010}"
  if [ "$nginx_on" = "true" ]; then
    default_pub_url="https://${ip}/supabase"
  else
    default_pub_url="http://${ip}:${gwport}"
  fi
  python3 - "$SUPABASE_ENV_FILE" "$default_pub_url" <<'PY'
import sys
f, url = sys.argv[1], sys.argv[2]
s = open(f).read().replace("SUPABASE_PUBLIC_URL=__GENERATED__", f"SUPABASE_PUBLIC_URL={url}")
open(f, "w").write(s)
PY
  echo
  echo "  ► Edit $SUPABASE_ENV_FILE now and set CHEESE_AUTH_ALLOWED_DOMAINS"
  echo "    (comma-separated email domains allowed to register), and confirm"
  echo "    SUPABASE_PUBLIC_URL is reachable from users' browsers."
  read -rp "  Press ENTER to open it in your editor (or Ctrl-C to edit manually later)..." _ || true
  # open_in_editor resolves $VISUAL/$EDITOR or an installed editor; if none is
  # found it prints the path to edit manually — don't abort setup over that,
  # the domain list can be fixed with an edit + re-run.
  open_in_editor "$SUPABASE_ENV_FILE" || echo "  (edit it manually, then re-run: cheese setup-supabase)"
fi

# Fill any __GENERATED__ secret placeholders (kept stable across re-runs).
fill_secret() {  # fill_secret KEY VALUE
  python3 - "$SUPABASE_ENV_FILE" "$1" "$2" <<'PY'
import sys
f, key, val = sys.argv[1], sys.argv[2], sys.argv[3]
out = []
for line in open(f):
    if line.startswith(f"{key}=") and line.rstrip("\n").endswith("__GENERATED__"):
        out.append(f"{key}={val}\n")
    else:
        out.append(line)
open(f, "w").write("".join(out))
PY
}

current="$(sb_env JWT_SECRET)"
if [ "$current" = "__GENERATED__" ]; then
  jwt_secret="$(gen_secret)$(gen_secret)"   # ~64 chars, well over the 32 min
  fill_secret JWT_SECRET "$jwt_secret"
else
  jwt_secret="$current"
fi

[ "$(sb_env POSTGRES_PASSWORD)" = "__GENERATED__" ] && fill_secret POSTGRES_PASSWORD "$(gen_secret)"
[ "$(sb_env DASHBOARD_PASSWORD)" = "__GENERATED__" ] && fill_secret DASHBOARD_PASSWORD "$(gen_secret)"
# anon/service keys are derived from JWT_SECRET, so (re)generate whenever they're placeholders.
[ "$(sb_env ANON_KEY)" = "__GENERATED__" ]         && fill_secret ANON_KEY "$(gen_jwt "$jwt_secret" anon)"
[ "$(sb_env SERVICE_ROLE_KEY)" = "__GENERATED__" ] && fill_secret SERVICE_ROLE_KEY "$(gen_jwt "$jwt_secret" service_role)"

# ── 2. Render gateway config + Studio basic-auth file ─────────────────────────
cp "${REPO_FOLDER}/config/supabase/gateway.conf.template" "${SUPABASE_CONFIG_DIR}/gateway.conf"
dash_user="$(sb_env DASHBOARD_USERNAME)"; dash_pw="$(sb_env DASHBOARD_PASSWORD)"
printf '%s:%s\n' "$dash_user" "$(openssl passwd -apr1 "$dash_pw")" > "${SUPABASE_CONFIG_DIR}/gateway.htpasswd"

# ── 3. Pull + start the Supabase stack ────────────────────────────────────────
echo "Pulling Supabase images (this can take a while the first time)..."
supabase_compose pull
echo "Starting Supabase..."
clear_stray_cheese_containers "$SUPABASE_COMPOSE_FILE" cheese-supabase
supabase_compose up -d

# ── 4. Apply roles → CHEESE schema → on-prem overlay ──────────────────────────
wait_db_ready

echo "Applying role bootstrap..."
pgpw="$(sb_env POSTGRES_PASSWORD)"
sed "s/__POSTGRES_PASSWORD__/${pgpw}/g" "${SQL_SRC}/00-roles.sql.template" | psql_db

wait_auth_ready

echo "Applying CHEESE schema..."
# The base schema isn't guarded with IF NOT EXISTS, so don't blind-apply with
# errors suppressed (that would also swallow REAL failures and leave a
# half-created schema that only breaks later, at per-user-isolation time).
# Instead: skip when the sentinel table is already there, otherwise apply
# strictly — ON_ERROR_STOP inside one transaction (-1), so a failure rolls the
# whole schema back and the sentinel check stays accurate for the re-run.
if psql_db -tAc "SELECT to_regclass('public.profiles') IS NOT NULL" </dev/null | grep -q t; then
  echo "  CHEESE schema already present — skipping."
else
  psql_db -1 < "${SQL_SRC}/01-cheese-schema.sql"
  psql_db -tAc "SELECT to_regclass('public.profiles') IS NOT NULL" </dev/null | grep -q t \
    || { echo "CHEESE schema did not apply cleanly (public.profiles missing) — see errors above." >&2; exit 1; }
fi

echo "Applying on-prem overlay (premium default + domain restriction)..."
# Build a SQL array literal from CHEESE_AUTH_ALLOWED_DOMAINS.
domains_sql="$(python3 - "$(sb_env CHEESE_AUTH_ALLOWED_DOMAINS)" <<'PY'
import re, sys
doms = [d.strip().lower().lstrip("@") for d in sys.argv[1].split(",") if d.strip()]
if not doms:
    sys.stderr.write("CHEESE_AUTH_ALLOWED_DOMAINS is empty — refusing to allow all domains.\n"); sys.exit(1)
# Strict charset: a hostname can only contain these. This also keeps the value
# safe for the sed substitution below (no /, &, \ can reach it).
bad = [d for d in doms if not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?", d)]
if bad:
    sys.stderr.write(f"CHEESE_AUTH_ALLOWED_DOMAINS contains invalid domain(s): {', '.join(bad)}\n"); sys.exit(1)
print("ARRAY[" + ",".join("'" + d + "'" for d in doms) + "]")
PY
)"
sed "s/__ALLOWED_DOMAINS_SQL__/${domains_sql}/g" "${SQL_SRC}/02-onprem-overlay.sql.template" | psql_db

# PostgREST connected before the roles/schema existed — restart so it picks up
# the authenticator role and reloads its schema cache.
echo "Restarting PostgREST to load the schema..."
supabase_compose restart rest >/dev/null

# ── 5. Wire the main CHEESE stack to use this Supabase ────────────────────────
pub_url="$(sb_env SUPABASE_PUBLIC_URL)"
anon="$(sb_env ANON_KEY)"; service="$(sb_env SERVICE_ROLE_KEY)"

# Select the auth UI image variant. The UI's feature flags are inlined at build
# time, so accounts need the auth-enabled image (published per channel as
# <channel>-auth, e.g. develop-auth / latest-auth). Pin the UI to that variant via
# CHEESE_UI_IMAGE_TAG (the compose ui image and `cheese update-images` both honor
# it); the rest of the stack stays on the plain channel tag. The channel is
# CHEESE_IMAGE_TAG, already resolved and exported by _compose-env (sourced via
# _supabase-common) — one derivation, no drift.
ui_auth_tag="${CHEESE_IMAGE_TAG}-auth"

python3 - "$CONF" \
  "ENABLE_AUTH=true" \
  "ENABLE_SUPABASE=true" \
  "ENABLE_STRIPE=false" \
  "ENABLE_TRACKING=true" \
  "CHEESE_UI_IMAGE_TAG=${ui_auth_tag}" \
  "SUPABASE_URL=http://supabase-gateway:8000" \
  "SUPABASE_PUBLIC_URL=${pub_url}" \
  "SUPABASE_ANON_KEY=${anon}" \
  "SUPABASE_SERVICE_ROLE_KEY=${service}" \
  "SUPABASE_JWT_ISSUER=${pub_url}/auth/v1" <<'PY'
import sys
conf = sys.argv[1]; kvs = [a.split("=", 1) for a in sys.argv[2:]]
lines = open(conf).read().splitlines(keepends=True) if __import__("os").path.exists(conf) else []
def upsert(lines, key, val):
    out, done = [], False
    for ln in lines:
        stripped = ln.lstrip("#").strip()
        if stripped.startswith(key + "=") and not done:
            out.append(f"{key}={val}\n"); done = True
        else:
            out.append(ln)
    if not done:
        if out and not out[-1].endswith("\n"): out[-1] += "\n"
        out.append(f"{key}={val}\n")
    return out
for k, v in kvs:
    lines = upsert(lines, k, v)
open(conf, "w").write("".join(lines))
PY

echo
echo "✅ Supabase is up and the CHEESE stack is wired for accounts."
echo "   Studio (admin):   ${pub_url}/   (login: ${dash_user} / value in supabase.env)"
echo "   Allowed signup domains: $(sb_env CHEESE_AUTH_ALLOWED_DOMAINS)"
echo
echo "   Pull the auth UI image variant and restart so the stack picks up accounts:"
echo "       cheese update-images        # pulls cheese-search-ui:${ui_auth_tag}"
echo "       cheese stop && cheese start"
echo
echo "   NOTE: the login UI is inlined at build time, so accounts need the"
echo "   auth-enabled image — now selected automatically (CHEESE_UI_IMAGE_TAG=${ui_auth_tag})."
echo "   The browser gets the self-hosted Supabase URL + anon key at runtime from"
echo "   SUPABASE_PUBLIC_URL/SUPABASE_ANON_KEY (see docs/supabase-auth-setup.md)."
