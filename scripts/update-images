#!/bin/bash

set -e

echo Downloading CHEESE images...
# An explicit CHEESE_REGISTRY in cheese-env-file.conf overrides the default
# (e.g. a mirror).
CHEESE_REGISTRY="${CHEESE_REGISTRY:-815935788477.dkr.ecr.us-east-1.amazonaws.com}"
REGISTRY="$CHEESE_REGISTRY"
REPO_NAME="${REGISTRY}/on-prem"

# ── Image channel (develop vs main) ───────────────────────────────────────────
# Mirror the resolution in scripts/_compose-env so `update-images` pulls exactly
# the tags `cheese start` will run. main checkout → :latest, develop (or any
# other branch) → :dev; an explicit CHEESE_IMAGE_TAG wins; non-git → :latest.
# Only the per-branch product images (database/orchestrator/search-ui/
# alignment-service) are channel-tagged — the rest are published as :latest only.
if [ -z "${CHEESE_IMAGE_TAG:-}" ]; then
  _onprem_branch="$(git -C "${REPO_FOLDER:-.}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  case "$_onprem_branch" in
    main|"") CHEESE_IMAGE_TAG="latest"  ;;
    *)       CHEESE_IMAGE_TAG="develop" ;;
  esac
  unset _onprem_branch
fi
echo "Image channel: pulling '${CHEESE_IMAGE_TAG}' tag for product images (database/orchestrator/search-ui/alignment-service)."

# image_tag IMAGE → the tag to pull for that image. Branch-tagged product images
# follow the channel; everything else is :latest. cheese-search-ui additionally
# honors CHEESE_UI_IMAGE_TAG (a feature-flag variant like <channel>-auth, set by
# `cheese setup-supabase`), falling back to the plain channel tag — so a stack
# wired for accounts pulls the auth UI variant while the rest track the channel.
image_tag() {
  case "$1" in
    cheese-search-ui) echo "${CHEESE_UI_IMAGE_TAG:-$CHEESE_IMAGE_TAG}" ;;
    cheese-database|cheese-orchestrator|cheese-alignment-service) echo "$CHEESE_IMAGE_TAG" ;;
    *) echo "latest" ;;
  esac
}

# image_repo IMAGE → the ECR repository that image is published to. Images live
# at on-prem/cheese/<image>: one repository per product image, no customer
# segment — the images are customer-agnostic and a tailored build is a tag, not
# a repository. cheese-database and cheese-orchestrator have moved; the rest are
# still published to the older on-prem/<image>/<customer> path and follow as
# each one's on-prem build is repointed.
image_repo() {
  case "$1" in
    cheese-database|cheese-orchestrator) echo "${REGISTRY}/on-prem/cheese/$1" ;;
    *) echo "${REPO_NAME}/$1/${CHEESE_CUSTOMER}" ;;
  esac
}

# ── Registry login (ECR) ─────────────────────────────────────────────────────
# Auth is IAM. The customer's access key (CHEESE_AWS_ACCESS_KEY_ID/
# CHEESE_AWS_SECRET_ACCESS_KEY in cheese-env-file.conf, provided by DeepMedChem)
# carries no ECR permission itself — its one right is assuming the pull-only
# role (CHEESE_AWS_ROLE_ARN), whose temporary credentials mint the short-lived
# docker-login token. `aws` runs inside the official public aws-cli container so
# customers need no new tooling — docker is already a requirement.
if [ -z "${CHEESE_AWS_ACCESS_KEY_ID:-}" ] || [ -z "${CHEESE_AWS_SECRET_ACCESS_KEY:-}" ]; then
  echo "ERROR: registry $REGISTRY needs CHEESE_AWS_ACCESS_KEY_ID and CHEESE_AWS_SECRET_ACCESS_KEY"
  echo "in ~/.config/cheese/cheese-env-file.conf. Ask the DeepMedChem team for your keys."
  echo "(CHEESE_PASSWORD is obsolete and no longer works.)"
  exit 1
fi
ecr_token=$(docker run --rm --entrypoint /bin/sh \
  -e AWS_ACCESS_KEY_ID="$CHEESE_AWS_ACCESS_KEY_ID" \
  -e AWS_SECRET_ACCESS_KEY="$CHEESE_AWS_SECRET_ACCESS_KEY" \
  -e AWS_DEFAULT_REGION="${CHEESE_AWS_REGION:-us-east-1}" \
  -e ROLE_ARN="${CHEESE_AWS_ROLE_ARN:-arn:aws:iam::815935788477:role/cheese-onprem-pull}" \
  public.ecr.aws/aws-cli/aws-cli -c '
    set -e
    creds=$(aws sts assume-role --role-arn "$ROLE_ARN" \
      --role-session-name cheese-update-images \
      --query "Credentials.[AccessKeyId,SecretAccessKey,SessionToken]" --output text)
    export AWS_ACCESS_KEY_ID=$(echo "$creds" | cut -f1)
    export AWS_SECRET_ACCESS_KEY=$(echo "$creds" | cut -f2)
    export AWS_SESSION_TOKEN=$(echo "$creds" | cut -f3)
    aws ecr get-login-password
  ')
# docker login takes the bare registry hostname, not a repo path; --password-stdin
# avoids the insecure-CLI-password warning.
printf '%s' "$ecr_token" | docker login -u AWS --password-stdin "$REGISTRY"

# Pull the CHEESE app images
echo "Images included in package :" $CHEESE_PACKAGE
echo "To change the package contents please use cheese update-env"
read -p "Do you want to pull the latest images? (y/n)" answer

case "$answer" in
    [Yy]* )
        echo "Pulling the images according to the above package."

        # Canonical pull order — images are always pulled in this sequence
        # regardless of how CHEESE_PACKAGE happens to list them, so the order is
        # deterministic. cheese-database is first because it's also the image
        # that generates the license key (cheese generate-license-key), so it
        # must be available before anything else.
        CHEESE_PULL_ORDER="cheese-database cheese-search-ui cheese-orchestrator cheese-electrostatics-inference cheese-inference cheese-alignment-service"

        # Normalise CHEESE_PACKAGE into a whitespace-trimmed, space-delimited
        # lookup string (",a, b ,c," → " a b c ") for membership tests.
        requested=" "
        IFS=',' read -ra strings <<< "$CHEESE_PACKAGE"
        for s in "${strings[@]}"; do
            s="${s//[[:space:]]/}"
            [ -n "$s" ] && requested="${requested}${s} "
        done

        pull_image() {
            local tag repo
            tag="$(image_tag "$1")"
            repo="$(image_repo "$1")"
            echo "Pulling ${repo}:${tag}"
            docker pull "${repo}:${tag}"
        }

        # 1) Recognised images, in canonical order.
        for image_name in $CHEESE_PULL_ORDER; do
            case "$requested" in *" $image_name "*) pull_image "$image_name" ;; esac
        done

        # 2) Any requested image not in the canonical order — pull it last rather
        #    than silently dropping it.
        for image_name in $requested; do
            case " $CHEESE_PULL_ORDER " in
                *" $image_name "*) : ;;  # already pulled above
                *) echo "⚠️  '$image_name' is not in the known pull order — pulling it last."
                   pull_image "$image_name" ;;
            esac
        done
        ;;
    [Nn]* )
        exit 0
        ;;
    * )
        echo "Invalid response. Please enter y or n."
        ;;
esac


# Pull Nginx and Oauth2-proxy images
if [ $NGINX == "true" ];then
echo "Pulling nginx image..."
docker pull docker.io/library/nginx:alpine
echo "Pulling oauth2 image..."
docker pull quay.io/oauth2-proxy/oauth2-proxy:latest

fi

# Pre-pull the AWS CLI image used by configure-dbs / download-dbs when the host
# has no aws CLI of its own (those scripts prefer a host CLI and fall back to
# this container). Doing it here keeps the first database download from stalling
# on an image pull.
if ! command -v aws >/dev/null 2>&1; then
  AWSCLI_IMAGE="${AWSCLI_IMAGE:-public.ecr.aws/aws-cli/aws-cli}"
  echo "No host aws CLI found — pulling $AWSCLI_IMAGE for database transfers..."
  echo "(Installing the AWS CLI instead is faster: bash install/install-aws-cli.sh)"
  docker pull "$AWSCLI_IMAGE" || echo "⚠️  Could not pull $AWSCLI_IMAGE — 'cheese download-dbs' will retry on first use."
fi