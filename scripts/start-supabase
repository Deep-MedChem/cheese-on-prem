#!/bin/bash
# Bring up the slim self-hosted Supabase stack (separate compose project,
# shared cheese-network). Run `cheese setup-supabase` first — it generates the
# secrets/config this needs.

set -e
source "$(dirname "$(readlink -f "$0")")/_supabase-common"

if [ ! -f "$SUPABASE_ENV_FILE" ]; then
  echo "Supabase is not configured yet. Run: cheese setup-supabase" >&2
  exit 1
fi

echo "Starting Supabase..."
clear_stray_cheese_containers
supabase_compose up -d
echo "Supabase is up. Gateway/Studio on :$(sb_env SUPABASE_GATEWAY_PORT)."
