#!/bin/bash
# Stop the self-hosted Supabase stack. Data persists in the supabase-db-data
# volume, so `cheese start-supabase` brings it back with all users intact.
# Pass --wipe to also delete that volume (DESTROYS ALL USER ACCOUNTS + DATA).
#
# NOTE: `cheese start` auto-starts Supabase again whenever supabase.env exists
# and SUPABASE_ENABLED isn't false — to keep accounts off across restarts, set
# SUPABASE_ENABLED=false in cheese-env-file.conf (see docs/supabase-auth-setup.md).

set -e
source "$(dirname "$(readlink -f "$0")")/_supabase-common"

# Graceful when supabase.env has been deleted: compose can't parse the stack
# without its env-file, but `-p` alone can still find the project's containers
# by label, so teardown keeps working.
compose_down() {
  if [ -f "$SUPABASE_ENV_FILE" ]; then
    supabase_compose down "$@"
  else
    echo "(supabase.env is gone — stopping the cheese-supabase project by label)"
    docker compose -p cheese-supabase down "$@" 2>/dev/null || true
  fi
}

if [ "${1:-}" = "--wipe" ]; then
  read -rp "This DELETES all Supabase users and per-user data. Type 'wipe' to confirm: " ans
  [ "$ans" = "wipe" ] || { echo "Aborted."; exit 1; }
  compose_down -v
  echo "Supabase stopped and its data volume removed."
else
  compose_down
  echo "Supabase stopped (data preserved). Restart with: cheese start-supabase"
fi
