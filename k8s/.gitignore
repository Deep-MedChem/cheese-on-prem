# Local env and secrets — examples (.example) are tracked; real ones aren't.
local-dev/env/*.build.env
*.env
*.local
*.local.sh
charts/*/values-secrets.yaml
charts/*/values-onprem.yaml
local-dev/kind/cluster.local.yaml
!*.example

# License files — keyed to the host hardware, never commit.
cheese_license_file.json
*license*.json
*license*.yaml
# …but the chart's licence-agent templates are chart SOURCE, not licences.
!charts/cheese/templates/license-agent-*.yaml

# Build outputs
dist/
build/
coverage/

# Logs
*.log
logs/

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Kubernetes / local cluster artifacts
kubeconfig*
*.kubeconfig

# Optional local scratch files
tmp/
*.tmp

# Test configs used for development
*-TEST.yaml